{
  "services": {
    "financial-document-intelligence": {
      "root": ".",
      "entrypoint": "backend.app.main:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "financial-document-intelligence"
      }
    }
  ]
}
